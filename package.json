{
  "name": "encore",
  "private": true,
  "description": "Encore social movie-ranking app",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "npm --prefix app run start:tunnel",
    "start:lan": "npm --prefix app start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db": "bash supabase/tests/run-database-tests.sh",
    "check:functions": "npx --yes deno@2.9.6 check --no-lock --config supabase/functions/search-movies/deno.json supabase/functions/search-movies/index.ts"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "supabase": "^2.122.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
