# The team's shared Supabase development project. Expo loads this file for
# `expo start`, so the app runs without any local configuration.
#
# These values are safe to commit: the publishable key is meant to ship inside
# the app, and row-level security limits every signed-in user to their own data.
# Never put the secret key in any app/.env file.
#
# To point your copy at another project, such as a local Supabase stack, put the
# same two keys in app/.env.local. That file overrides this one and stays out of git.
EXPO_PUBLIC_SUPABASE_URL=https://hnbggyskvhbksdrlujfy.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_AE8Fxi-kwM3Loi-Lf0P35A_W679h-eO
